---
import {site} from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" aria-label="UK Trade Websites - Home"><img src={site.logo} alt="UK Trade Websites logo" width="100" height="100" loading="lazy"/></a>
      <p>Websites for UK trades. More calls. More quotes. More jobs.</p>
    </div>
    <nav aria-label="Footer navigation" class="footer-nav">
      <a href="/pricing/">Website Pricing</a>
      <a href="/about-us/">About Us</a>
      <a href="/contact-us/">Contact Us</a>
      <a href="/blog/">Blog</a>
      <a href="/our-work/">Our Work</a>
      <a href="/our-process/">Our Process</a>
      <a href="/privacy-policy/">Privacy Policy</a>
    </nav>
    <div class="footer-action"><a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-accent">WhatsApp Us</a><span class="footer-email" set:html={'<!--email_off--><a href="mailto:'+site.email+'">'+site.email+'</a><!--/email_off-->'}/><p class="footer-hours">Enquiry hours: {site.contactHours.label}</p></div>
  </div>
  <div class="container footer-bottom">
    <a href="#main-content">Back to top ↑</a>
    <span>© {new Date().getFullYear()} UK Trade Websites</span>
    <span>UK Trade Websites is a trade-focused service by <a href="https://prunusmedia.com/" target="_blank" rel="noopener noreferrer">Prunus Media</a>.</span>
  </div>
</footer>
