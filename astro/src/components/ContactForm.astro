---
import {site} from '../data/site';
interface Props {heading?:string;id?:string;}
const {heading='Grow Your Business',id='enquiry'}=Astro.props;
---
<section class="contact-panel" aria-labelledby={id+'-heading'}>
  <h2 id={id+'-heading'}>{heading}</h2>
  <form class="contact-form" action={site.formAction} method="POST">
    <div class="form-grid">
      <label>Name<input type="text" name="name" autocomplete="name" required/></label>
      <label>Email<input type="email" name="email" autocomplete="email" required/></label>
      <label>Phone<input type="tel" name="phone" autocomplete="tel"/></label>
      <label>Business Name<input type="text" name="business" autocomplete="organization"/></label>
      <label class="wide">Service Needed<select name="service">
        <option>Website Design</option><option>SEO</option><option>Website + SEO</option><option>Maintenance</option>
      </select></label>
      <label class="wide">Tell us about your project<textarea name="message" rows="4"></textarea></label>
    </div>
    <input type="hidden" name="package" value="" data-package-choice/>
    <input type="hidden" name="_subject" value="New Website Enquiry - UK Trade Websites"/>
    <input type="hidden" name="_redirect" value="https://uktradewebsites.co.uk/thank-you/"/>
    <div class="honeypot" aria-hidden="true"><label>Leave this empty<input type="text" name="_gotcha" autocomplete="off" tabindex="-1"/></label></div>
    <button class="btn btn-accent" type="submit">Send Message</button>
    <p class="form-privacy">We use your information to respond to your enquiry. <a href="/privacy-policy/">Privacy Policy</a>.</p>
  </form>
</section>

<script>
  // Preserve the package the visitor selected without introducing a backend.
  const selectedPackage = new URLSearchParams(window.location.search).get('package');
  if (selectedPackage) {
    document.querySelectorAll<HTMLInputElement>('[data-package-choice]').forEach(input => {
      input.value = selectedPackage.slice(0, 160);
    });
  }
</script>
