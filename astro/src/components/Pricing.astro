---
import {packages, monthlyOnly, seoHosting} from '../data/site';
interface Props {fullPage?:boolean;}
const {fullPage=false}=Astro.props;
---
<section class="section pricing-section" id="pricing" aria-labelledby="pricing-title">
 <svg class="pricing-wave" aria-hidden="true" viewBox="0 0 1440 560" preserveAspectRatio="none"><path fill="#FF8C42" d="M0,145 C250,210 500,235 725,212 C995,180 1190,70 1440,0 V540 C1110,432 880,395 610,405 C375,414 205,435 0,476 Z"/></svg>
 <div class="container">
   <div class="section-heading pricing-heading">
     <p class="eyebrow">Straightforward website prices</p>
     <h2 id="pricing-title">Our trade website packages</h2>
     <p>Choose the website that fits your trade business. Clear pricing, no unnecessary extras.</p>
   </div>
   <div class="pricing-grid pricing-grid-three">
    {packages.map(plan=>
      <article class:list={['price-card',{'featured':plan.featured}]}>
        {plan.featured&&<span class="best-choice">Popular choice</span>}
        <h3>{plan.name}</h3>
        <p class="price-page-range">{plan.pageRange}</p>
        <p class="upfront"><strong>£{plan.upfront}</strong> one-off build cost</p>
        <p class="monthly">£<strong>{plan.monthly}</strong><span> /month</span></p>
        <p class="monthly-label">Standard hosting &amp; technical upkeep</p>
        <p class="contract">12-month minimum term</p>
        <p class="price-description">{plan.description}</p>
        <ul class="tick-list">{plan.items.map(item=><li>{item}</li>)}</ul>
        <a class="btn btn-primary" href={'/contact-us/#package='+encodeURIComponent(plan.name)}>Enquire about {plan.name}</a>
      </article>
    )}
   <article class="price-card no-upfront-card">
     <span class="best-choice">£0 upfront</span>
     <h3>{monthlyOnly.name}</h3>
     <p class="price-page-range">{monthlyOnly.pageRange}</p>
     <p class="upfront"><strong>£0</strong> upfront build cost</p>
     <p class="monthly">£<strong>{monthlyOnly.monthly}</strong><span> /month</span></p>
     <p class="monthly-label">First 12 months · then £{monthlyOnly.hostingAfterYear}/month</p>
     <p class="contract">12-month minimum term</p>
     <p class="price-description">{monthlyOnly.description}</p>
     <ul class="tick-list">{monthlyOnly.items.map(item=><li>{item}</li>)}</ul>
     <a class="btn btn-primary" href={'/contact-us/#package='+encodeURIComponent(monthlyOnly.name)}>Enquire about no-upfront</a>
   </article>
   </div>
   <aside class="prunus-referral" aria-labelledby="prunus-referral-title">
     <svg class="prunus-floral" viewBox="0 0 430 320" aria-hidden="true" focusable="false">
       <g fill="none" stroke="#af8097" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
         <path d="M438 321C345 265 345 175 286 115S220 53 176 23M363 243c-43-27-78-17-121-48M331 179c46-19 57-55 62-85M286 115c-27-16-53-12-73-42M242 195c-45-2-67 22-90 46"/>
         <path d="M309 140c-34-30-36-54-16-74 22 13 30 41 16 74ZM350 218c-15-35-3-59 19-62 11 20 7 42-19 62Z"/>
       </g>
       <g fill="#f8e6ec" stroke="#c39aab" stroke-width="1.25">
         <path d="M180 26c-25-23-41-16-36 2-23-5-32 9-18 21-16 15-7 28 15 23 6 21 23 23 33 4 22 8 33-5 23-24 12-18 0-32-17-26Z"/>
         <path d="M281 111c-18-26-35-23-34-6-23-10-31 6-15 19-17 12-9 28 10 27 3 23 20 27 32 10 21 9 34-2 24-20 16-15 7-30-17-30Z"/>
         <path d="M157 243c-19-25-36-23-35-5-21-9-31 5-17 19-15 14-8 29 11 28 4 22 22 25 32 8 20 10 33-2 23-19 13-15 7-28-14-31Z"/>
         <path d="M390 94c-17-23-33-21-33-4-20-8-30 6-15 18-13 11-7 26 11 26 4 20 20 25 31 8 19 9 32-3 22-18 13-16 4-29-16-30Z"/>
       </g>
       <g fill="#ba899c"><circle cx="159" cy="50" r="5"/><circle cx="265" cy="131" r="5"/><circle cx="143" cy="265" r="5"/><circle cx="377" cy="113" r="5"/></g>
     </svg>
     <div class="prunus-referral-content">
       <div class="prunus-brand">
         <img class="prunus-logo" src="/wp-content/uploads/2026/05/Prunus-Media-Left-orientation-300x300.png" width="98" height="98" alt="Prunus Media logo" loading="lazy" decoding="async" />
         <span class="prunus-brand-label">A little more than a trade website?</span>
       </div>
       <div class="prunus-referral-body">
         <div>
           <h3 id="prunus-referral-title">Need a bigger website?</h3>
           <p>For bespoke websites, 10+ pages or advanced features, our wider agency Prunus Media can help you grow beyond a standard trade website.</p>
         </div>
         <a href="https://prunusmedia.com/" rel="noopener noreferrer" class="btn btn-primary">Visit Prunus Media <span aria-hidden="true">↗</span></a>
       </div>
     </div>
   </aside>
   <aside class="seo-hosting-band" aria-labelledby="seo-hosting-title">
     <div>
       <p class="eyebrow">Want to improve your Google visibility?</p>
       <h3 id="seo-hosting-title">{seoHosting.heading}</h3>
       <p>{seoHosting.detail}</p>
       <p class="seo-hosting-small">{seoHosting.financedNote}</p>
     </div>
     <a class="btn btn-accent" href="/contact-us/#package=Ongoing%20SEO%20with%20hosting">Ask about SEO</a>
   </aside>
   <p class="pricing-smallprint">Five-page enquiries can be quoted in Starter or Growth depending on the design and scope. All packages cover the agreed scope; monthly payments cover hosting, SSL and basic technical upkeep, not unlimited amendments, ongoing SEO, domain renewals or paid third-party tools. Contact us for a written quote before starting.</p>
   {!fullPage&&<p class="text-center pricing-page-cta"><a class="btn btn-outline" href="/pricing/">Compare pricing, terms and FAQs</a></p>}
 </div>
</section>
