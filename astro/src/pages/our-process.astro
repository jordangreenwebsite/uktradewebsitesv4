---
import Layout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import {site} from '../data/site';
const steps=[
 ['Choose your website','Pick the plan that suits your business and tell us about the services you offer.'],
 ['Send us your details',"Provide your logo, contact details, services and service areas. If you don't have everything ready, we'll help you out."],
 ['We build your website','We design and build your website using proven layouts built specifically for trades and service businesses.'],
 ['Launch and start getting enquiries','Once approved, your website goes live and customers can start contacting you through your new site.'],
];
const faqs=[
 ['How long does it take?','Most websites are completed within just a few days once we have everything we need from you. We keep the process simple so you can get online quickly without delays.'],
 ['What do you need from me?','We just need some basic information about your business, the services you offer, and the areas you cover. If you have photos we can use, please share them. If not, we can help with that.'],
 ['Can you help with content?','Yes! We can guide you through what to include and help structure your content so it looks professional and is easy for customers to understand.'],
 ['Do you handle hosting?','Yes, we take care of everything so your website stays live, secure, and running smoothly.']
];
---
<Layout title="Our Process - Trade Website Design Made Simple" description="We make getting your trade website simple. From setup to launch, our step-by-step process helps you get online fast and start generating more enquiries." path="/our-process/">
<section class="page-hero"><div class="container"><h1>Our Simple Website Process</h1><p class="lead">From first enquiry to a professional website in just a few days.</p><a href="/contact-us/" class="btn btn-accent">Get Started</a></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>A Simple 4-Step Process</h2><p>We've designed our process to be quick and straightforward so you can focus on running your business.</p></div><div class="steps">{steps.map(([heading,description],i)=><article class="info-card"><div class="step-number">{i+1}</div><h3>{heading}</h3><p>{description}</p></article>)}</div></div></section>
<section class="section section-light"><div class="container split-grid"><div><h2>How Long Does It Take?</h2><h3>Most trade websites are completed within 5–7 days after we receive all your details.</h3><p>Timelines vary with how quickly content and approvals are supplied.</p></div><div class="feature-panel"><h2>Timeline Example</h2><ul class="check-list"><li>Day 1 — Send your information</li><li>Day 3 — Website preview ready</li><li>Day 5–7 — Website launched</li></ul></div></div></section>
<section class="section"><div class="container split-grid"><div><h2>What we need from you:</h2><ul class="check-list"><li>Business Name</li><li>Services you offer</li><li>Areas you work in</li><li>Contact details</li><li>Logo</li></ul><p>Don't worry if you need help with anything. We can help.</p></div><img src="/wp-content/uploads/2026/03/timothy-muza-6VjPmyMj5KM-unsplash-1024x683.jpg" alt="Website planning workspace with laptop" width="1024" height="683" loading="lazy"/></div></section>
<section class="section section-light"><div class="container"><h2 class="text-center">Frequently Asked Questions</h2><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
<section class="bottom-contact"><div class="container"><p class="eyebrow text-center">Ready to get your website online?</p><ContactForm id="process"/></div></section>
</Layout>
