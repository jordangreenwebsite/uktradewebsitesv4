---
import Layout from '../../layouts/BaseLayout.astro';
import {getCollection,render,type CollectionEntry} from 'astro:content';
import {site} from '../../data/site';

export async function getStaticPaths(){
  // Newest first; move forward through the articles, then wrap to the newest.
  // The title is a stable tie-breaker if multiple posts share a date.
  const posts=(await getCollection('blog')).sort((a,b)=>
    b.data.date.getTime()-a.data.date.getTime()||a.data.title.localeCompare(b.data.title)
  );
  return posts.map((post,index)=>({
    params:{slug:post.id},
    props:{post,nextPost:posts.length>1?posts[(index+1)%posts.length]:null}
  }));
}
interface Props {post:CollectionEntry<'blog'>;nextPost:CollectionEntry<'blog'>|null;}
const {post,nextPost}=Astro.props;
const nextUrl=nextPost?'/blog/'+nextPost.id+'/':'/blog/';
const nextDisplayDate=nextPost?.data.date.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
const {Content}=await render(post);
const url=site.url+'/blog/'+post.id+'/';
const published=post.data.date.toISOString().slice(0,10);
const updated=(post.data.updated||post.data.date).toISOString().slice(0,10);
const displayDate=post.data.date.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
const schema=[
  {'@type':'BlogPosting','@id':url+'#article',url,headline:post.data.title,description:post.data.description,
   datePublished:published,dateModified:updated,articleSection:post.data.category,inLanguage:'en-GB',
   author:{'@id':site.url+'/#organization'},publisher:{'@id':site.url+'/#organization'},
   mainEntityOfPage:{'@id':url+'#webpage'},isAccessibleForFree:true},
  {'@type':'BreadcrumbList',itemListElement:[
   {'@type':'ListItem',position:1,name:'Home',item:site.url+'/'},
   {'@type':'ListItem',position:2,name:'Blog',item:site.url+'/blog/'},
   {'@type':'ListItem',position:3,name:post.data.title,item:url}
  ]}
];
---
<Layout title={post.data.title+' | UK Trade Websites'} description={post.data.description}
 path={'/blog/'+post.id+'/'} schema={schema}>
 <div class="blog-read-next-top">
   <aside class="blog-read-next-band" aria-label="Recommended next article">
     <div class="container blog-read-next-inner">
       <div class="blog-read-next-copy">
         <p class="blog-read-next-eyebrow">Read next <span aria-hidden="true">→</span></p>
         <h2>{nextPost?nextPost.data.title:'Explore more trade website advice'}</h2>
         <p class="blog-read-next-meta">{nextPost?nextPost.data.category:'UK Trade Websites Blog'}{nextPost&&<> <span aria-hidden="true">·</span> <time datetime={nextPost.data.date.toISOString().slice(0,10)}>{nextDisplayDate}</time></>}</p>
       </div>
       <a class="blog-read-next-action" href={nextUrl} aria-label={nextPost?'Read next: '+nextPost.data.title:'Explore all blog articles'}>
         {nextPost?'Read next article':'All blog articles'} <span aria-hidden="true">→</span>
       </a>
     </div>
   </aside>
 </div>
 <header class="blog-post-header">
   <div class="container blog-post-header-inner">
     <nav class="blog-breadcrumbs" aria-label="Breadcrumbs">
       <a href="/">Home</a><span aria-hidden="true">/</span>
       <a href="/blog/">Blog</a><span aria-hidden="true">/</span>
       <span>{post.data.category}</span>
     </nav>
     <p class="eyebrow">{post.data.category}</p>
     <h1>{post.data.title}</h1>
     <p class="lead">{post.data.summary}</p>
     <p class="blog-post-meta">UK Trade Websites · <time datetime={published}>{displayDate}</time></p>
   </div>
 </header>
 <div class="container">
   <article class="blog-article">
     <div class="blog-prose"><Content /></div>
     <div class="blog-post-end">
       <a href="/blog/">More trade website advice</a>
       <a href="/contact-us/">Ask us about your website</a>
     </div>
   </article>
 </div>
</Layout>
